# Heavy data and images stay out of Git: the notebooks fetch them from the source.
# Narrowed to images only: data/raw/isic_clinical_metadata.csv is tracked, and a
# directory-level ignore cannot be undone with a later "!" rule.
data/raw/images/
*.tar
*.jpg
*.jpeg
*.png
*.PNG
*.JPG

# Frozen manifests and decisions ARE the project: small, and the pipeline cannot be
# reproduced without them. Ignore the directory's bulk, then name what must be shared.
# A subdirectory must be un-ignored before anything inside it can be: git does not
# descend into an ignored directory, so !data/processed/rag/*.json alone would not work.
data/processed/*
!data/processed/*.csv
!data/processed/*.json
!data/processed/rag/
!data/processed/rag/*.json
!data/splits/*.csv
!data/metadata/*.csv
!evaluation/*.csv
!reports/figures/*.png

# Environments, caches and model weights
.ipynb_checkpoints/
.venv/
__pycache__/
models/*.pt
models/*.safetensors
